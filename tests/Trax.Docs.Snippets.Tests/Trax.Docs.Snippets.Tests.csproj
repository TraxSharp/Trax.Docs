<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      The lockfile is what makes "compiled against the published release" true: CI restores it
      in locked mode (GitHub Actions sets CI=true), so a restore that would resolve anything
      else, the workspace's local 1.99.99 feed included, fails instead of passing on other bits.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <!--
    The packages a compiled snippet is checked against: the published releases on nuget.org,
    pinned exactly, never main and never the workspace's local 1.99.99 build. A fence marked
    `csharp compile` sees exactly these assemblies, so a page can only show an API a reader can
    install today. Bumping a pin re-checks every compiled snippet against the new release, and
    DocsPackageVersionsTests then asks for the versions shown on the pages to move with it.
  -->
  <ItemGroup Label="Trax">
    <PackageReference Include="Trax.Api" Version="1.44.2" />
    <PackageReference Include="Trax.Api.Auth.ApiKey" Version="1.44.2" />
    <PackageReference Include="Trax.Api.GraphQL" Version="1.44.2" />
    <PackageReference Include="Trax.Core" Version="1.8.0" />
    <PackageReference Include="Trax.Dashboard" Version="1.16.0" />
    <PackageReference Include="Trax.Effect" Version="1.57.4" />
    <PackageReference Include="Trax.Effect.Data.InMemory" Version="1.57.4" />
    <PackageReference Include="Trax.Effect.Data.Postgres" Version="1.57.4" />
    <PackageReference Include="Trax.Effect.JunctionProvider.Logging" Version="1.57.4" />
    <PackageReference Include="Trax.Effect.JunctionProvider.Progress" Version="1.57.4" />
    <PackageReference Include="Trax.Effect.Provider.Json" Version="1.57.4" />
    <PackageReference Include="Trax.Effect.Provider.Parameter" Version="1.57.4" />
    <PackageReference Include="Trax.Mediator" Version="1.23.3" />
    <PackageReference Include="Trax.Scheduler" Version="1.34.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supporting declarations for a page's snippets. Compiled with the snippets, not into this assembly. -->
    <Compile Remove="Context/**" />
    <None Include="Context/**" />
  </ItemGroup>

  <!--
    Hands the snippet compiler the same reference set this project compiles against: the
    framework reference packs plus every package above, reference assemblies where a package
    ships them. Written after the build, so a test run that skips the build still finds it.
  -->
  <Target Name="WriteSnippetReferences" AfterTargets="CopyFilesToOutputDirectory">
    <WriteLinesToFile
      File="$(OutDir)snippet-references.txt"
      Lines="@(ReferencePathWithRefAssemblies)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
  </Target>
</Project>
